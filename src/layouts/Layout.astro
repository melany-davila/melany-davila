---
import { basics } from "@cv"

interface Props {
  title: string
}

const { title } = Astro.props
const { image, summary, url } = basics

const baseUrl = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const imageSrc = image && (image.startsWith('http') || image.startsWith('data:'))
  ? image
  : `${baseUrl}${image ? image.replace(/^\//, '') : 'me.png'}`;

const faviconSrc = `${baseUrl}favicon.svg`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content={summary} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconSrc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={imageSrc} />

    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta name="twitter:description" content={summary} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Surfaces */
    --bg-base: #09090b;
    --bg-card: #121215;
    --bg-elevated: #18181c;
    --bg-overlay: rgba(0, 0, 0, 0.75);

    /* Borders */
    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-default: rgba(255, 255, 255, 0.14);
    --border-hover: rgba(255, 255, 255, 0.28);
    --border-card: rgba(255, 255, 255, 0.08);

    /* Text */
    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --text-tertiary: #71717a;
    --text-muted: #8b8b94;

    /* Technical Accents */
    --accent: #e4e4e7;
    --accent-subtle: rgba(255, 255, 255, 0.06);
    --accent-primary: #38bdf8;
    --accent-primary-subtle: rgba(56, 189, 248, 0.1);

    /* Type Scale */
    --fs-xs: 0.75rem;
    --fs-sm: 0.875rem;
    --fs-base: 1rem;
    --fs-lg: 1.125rem;
    --fs-xl: 1.25rem;
    --fs-2xl: 1.5rem;
    --fs-3xl: 2rem;
    --fs-4xl: 2.5rem;
    --fs-display: 2.75rem;

    /* Spacing */
    --sp-1: 0.25rem;
    --sp-2: 0.5rem;
    --sp-3: 0.75rem;
    --sp-4: 1rem;
    --sp-6: 1.5rem;
    --sp-8: 2rem;
    --sp-12: 3rem;

    /* Radii */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 18px;
    --radius-full: 9999px;

    /* Transitions */
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --duration-fast: 150ms;
    --duration-normal: 250ms;
  }

  html {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg-base);
    color: var(--text-primary);
    letter-spacing: -0.015em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.25);
  }

  ::-webkit-scrollbar-track {
    background-color: transparent;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--text-primary);
  }

  p {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.6;
    margin: 0;
    text-wrap: pretty;
  }

  .print {
    display: none !important;
  }

  @media print {
    :root {
      --bg-base: #ffffff;
      --bg-card: #ffffff;
      --bg-elevated: #ffffff;
      --border-card: transparent;
      --text-primary: #000000;
      --text-secondary: #27272a;
      --text-tertiary: #52525b;
      --text-muted: #3f3f46;
      --accent: #000000;
      --accent-primary: #000000;
    }

    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    html {
      background: #ffffff;
      color: #000000;
    }

    body {
      padding: 0;
      margin: 0;
    }

    astro-dev-toolbar {
      display: none !important;
    }

    main {
      padding: 0 !important;
      display: block !important;
      max-width: 100% !important;
    }

    section {
      border: none !important;
      background: transparent !important;
      padding: 0.75rem 0 !important;
      margin-bottom: 0.5rem !important;
      break-inside: avoid;
    }

    article {
      break-inside: avoid;
      border: none !important;
      background: transparent !important;
      padding: 0 !important;
      box-shadow: none !important;
    }

    h1, h2, h3, h4, p, span, li, time {
      color: #000000 !important;
      -webkit-text-fill-color: #000000 !important;
      background: transparent !important;
      text-shadow: none !important;
    }
  }
</style>
