---
import Section from "../Section.astro"
import { skills, languages } from "@cv"

const { class: className } = Astro.props;

// Función para calcular porcentaje según el nivel
function getLevelPercentage(level: string): number {
  const norm = level.toLowerCase();
  if (norm.includes("avanzado") || norm.includes("expert") || norm.includes("alto")) return 90;
  if (norm.includes("intermedio") || norm.includes("medio")) return 65;
  if (norm.includes("basico") || norm.includes("básico") || norm.includes("inicial")) return 40;
  if (norm.includes("nativo")) return 100;
  return 80;
}

// Iconos temáticos en SVG puro
---

<Section title="Habilidades & Competencias" class={`skills-section ${className || ''}`}>
  <div class="skills-wrapper">
    <!-- Grid de Habilidades -->
    <div class="skills-grid">
      {
        skills.map(({ name, level, keywords }) => {
          const percentage = getLevelPercentage(level || "Avanzado");
          return (
            <div class="skill-card">
              <div class="skill-header">
                <div class="skill-title-wrap">
                  <span class="skill-indicator-dot"></span>
                  <h3 class="skill-name">{name}</h3>
                </div>
                {level && <span class="skill-level-badge">{level}</span>}
              </div>

              <!-- Barra de nivel sutil -->
              <div class="skill-progress-track">
                <div class="skill-progress-bar" style={`width: ${percentage}%`} />
              </div>

              {keywords && keywords.length > 0 && (
                <ul class="keywords-list">
                  {keywords.map((keyword) => (
                    <li class="keyword-tag">{keyword}</li>
                  ))}
                </ul>
              )}
            </div>
          )
        })
      }
    </div>

    <!-- Sección de Idiomas -->
    {
      languages && languages.length > 0 && (
        <div class="languages-block">
          <h4 class="languages-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            Idiomas
          </h4>
          <div class="languages-grid">
            {languages.map(({ language, fluency }) => (
              <div class="language-card">
                <span class="language-name">{language}</span>
                <span class="language-fluency">{fluency}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Section>

<style>
  .skills-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
  }

  .skill-card {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .skill-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(244, 114, 182, 0.4);
    box-shadow: 0 4px 20px -8px rgba(244, 114, 182, 0.15);
    transform: translateY(-1px);
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .skill-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .skill-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f472b6, #c084fc);
    box-shadow: 0 0 8px rgba(244, 114, 182, 0.6);
    flex-shrink: 0;
  }

  .skill-name {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .skill-level-badge {
    font-size: 0.7rem;
    font-weight: 500;
    color: #f472b6;
    background: rgba(244, 114, 182, 0.1);
    border: 1px solid rgba(244, 114, 182, 0.2);
    padding: 2px 8px;
    border-radius: 9999px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .skill-progress-track {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 9999px;
    overflow: hidden;
  }

  .skill-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #f472b6, #a855f7, #38bdf8);
    border-radius: 9999px;
    transition: width 0.8s ease;
  }

  .keywords-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .keyword-tag {
    font-size: 0.72rem;
    color: var(--text-secondary);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  /* Idiomas */
  .languages-block {
    margin-top: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .languages-title {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--sp-2);
  }

  .language-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
  }

  .language-name {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-primary);
  }

  .language-fluency {
    font-size: 0.7rem;
    color: var(--text-tertiary);
  }

  @media print {
    .skill-card,
    .language-card {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      box-shadow: none !important;
      break-inside: avoid;
    }
    .skill-name,
    .language-name {
      color: #000 !important;
    }
    .skill-level-badge {
      color: #000 !important;
      background: #f4f4f5 !important;
      border-color: #d4d4d8 !important;
    }
    .skill-progress-bar {
      background: #71717a !important;
    }
  }
</style>

