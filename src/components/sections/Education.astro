---
import Section from "../Section.astro"
import { education } from "@cv"

const { class: className } = Astro.props;
---

<Section title="Educación & Certificaciones" class={`education-section ${className || ''}`}>
  <ul class="edu-list">
    {
      education.map(({ institution, startDate, endDate, area, studyType }) => {
        const startYear = startDate ? new Date(startDate).getFullYear() : ""
        const endYear = endDate ? new Date(endDate).getFullYear() : "Presente"
        const years = startYear ? `${startYear} — ${endYear}` : endYear

        return (
          <li class="edu-item">
            <article>
              <header class="edu-header">
                <div class="edu-meta">
                  <h3>{institution}</h3>
                  <h4>{studyType} {area ? `· ${area}` : ''}</h4>
                </div>

                <time>{years}</time>
              </header>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  .edu-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .edu-item article {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-2);
  }

  .edu-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .edu-meta h3 {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .edu-meta h4 {
    color: var(--text-secondary);
    font-size: var(--fs-xs);
    font-weight: 400;
  }

  time {
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    font-weight: 500;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    .edu-header {
      flex-direction: column;
      gap: 2px;
    }
  }

  @media print {
    .edu-meta h3 {
      color: #000 !important;
    }
    .edu-meta h4 {
      color: #3f3f46 !important;
    }
    time {
      color: #52525b !important;
    }
  }
</style>
