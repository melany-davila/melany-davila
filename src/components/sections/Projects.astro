---
import GitHub from "@/icons/GitHub.astro";
import ExternalLink from "@/icons/ExternalLink.astro";
import Layers from "@/icons/Layers.astro";
import Key from "@/icons/Key.astro";
import Close from "@/icons/Close.astro";
import ChevronLeft from "@/icons/ChevronLeft.astro";
import ChevronRight from "@/icons/ChevronRight.astro";
import Section from "../Section.astro";

import { projects } from "@cv";
const { class: className } = Astro.props;
---

<Section
  title="Proyectos Destacados"
  class={`projects-section ${className || ""}`}
>
  <ul class="projects-grid">
    {
      projects.map(
        ({
          url,
          description,
          highlights,
          name,
          isActive,
          github,
          architecture_summary,
          images,
          demo_credentials,
        }) => {
          const modalId = `modal-${name.replace(/[^a-zA-Z0-9-]/g, "").toLowerCase()}`;
          return (
            <li class="project-item">
              <article class="project-card">
                <header class="project-header">
                  <div class="title-row">
                    <h3>
                      <a
                        href={url || github || "#"}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`Ver ${name}`}
                      >
                        {name}
                      </a>
                    </h3>
                    <span class={`status-pill ${isActive ? "status-active" : "status-completed"}`}>
                      <span class="status-indicator"></span>
                      {isActive ? "En Producción" : "Finalizado"}
                    </span>
                  </div>
                  <p class="description">{description}</p>
                </header>

                <div class="tech-tags">
                  {highlights.map((highlight) => (
                    <span class="tech-tag">{highlight}</span>
                  ))}
                </div>

                <div class="card-actions no-print">
                  {demo_credentials && (
                    <div class="demo-creds-box">
                      <Key />
                      <span class="creds-content">
                        <strong>{demo_credentials.user}</strong> / <strong>{demo_credentials.password}</strong>
                      </span>
                    </div>
                  )}

                  <div class="actions-row">
                    {(url || github) && (
                      <a
                        href={url || github || "#"}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="cta primary-cta"
                        title="Ver enlace del proyecto"
                      >
                        <ExternalLink />
                        <span>Ver Proyecto</span>
                      </a>
                    )}
                    {architecture_summary && (
                      <button
                        type="button"
                        class="cta arch-cta"
                        data-modal={modalId}
                        title="Ver detalles de arquitectura"
                      >
                        <Layers />
                        <span>Arquitectura</span>
                      </button>
                    )}
                  </div>
                </div>
              </article>

              {architecture_summary && (
                <dialog id={modalId} class="arch-modal">
                  <div class="modal-content">
                    <header class="modal-header">
                      <div class="modal-title-row">
                        <h3>{name}</h3>
                        <span class={`status-pill ${isActive ? "status-active" : "status-completed"}`}>
                          <span class="status-indicator"></span>
                          {isActive ? "En Producción" : "Finalizado"}
                        </span>
                      </div>
                      <button
                        type="button"
                        class="close-modal"
                        data-close={modalId}
                        title="Cerrar modal"
                        aria-label="Cerrar modal"
                      >
                        <Close />
                      </button>
                    </header>

                    <div class="modal-body">
                      <div class="modal-media">
                        {images && images.length > 0 && (
                          <div class="carousel-wrapper">
                            <div class="carousel" data-carousel={modalId}>
                              {images.map((img) => (
                                <figure class="carousel-slide">
                                  <img
                                    src={img.src}
                                    alt={`Captura de pantalla de ${name}`}
                                    loading="lazy"
                                  />
                                  <figcaption>{img.caption}</figcaption>
                                </figure>
                              ))}
                            </div>
                            {images.length > 1 && (
                              <div class="carousel-controls">
                                <button
                                  type="button"
                                  class="nav-btn prev-btn"
                                  data-dir="prev"
                                  data-carousel-target={modalId}
                                  aria-label="Anterior captura"
                                >
                                  <ChevronLeft />
                                </button>
                                <div class="dots" data-dots={modalId}>
                                  {images.map((_, i) => (
                                    <span
                                      class={`dot ${i === 0 ? "active" : ""}`}
                                      data-index={i}
                                    />
                                  ))}
                                </div>
                                <button
                                  type="button"
                                  class="nav-btn next-btn"
                                  data-dir="next"
                                  data-carousel-target={modalId}
                                  aria-label="Siguiente captura"
                                >
                                  <ChevronRight />
                                </button>
                              </div>
                            )}
                          </div>
                        )}
                      </div>

                      <div class="modal-text">
                        {demo_credentials && (
                          <div class="demo-creds-box modal-creds">
                            <Key />
                            <span class="creds-label">Acceso Demo:</span>
                            <span class="creds-content">
                              Usuario: <strong>{demo_credentials.user}</strong> · Contraseña: <strong>{demo_credentials.password}</strong>
                            </span>
                          </div>
                        )}
                        {architecture_summary && (
                          <h4>Decisiones de Arquitectura</h4>
                          <div class="architecture-paragraphs">
                            {architecture_summary.split("\n\n").map((paragraph) => (
                              <p
                                set:html={paragraph.replace(
                                  /\*\*(.*?)\*\*/g,
                                  "<strong>$1</strong>",
                                )}
                              />
                            ))}
                          </div>
                        )}
                      </div>
                    </div>

                    {(url || github) && (
                      <footer class="modal-footer">
                        {url && (
                          <a
                            href={url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="modal-link primary-link"
                          >
                            <ExternalLink />
                            <span>Ver Demo en Vivo</span>
                          </a>
                        )}
                        {github && (
                          <a
                            href={github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="modal-link"
                          >
                            <GitHub />
                            <span>Código en GitHub</span>
                          </a>
                        )}
                      </footer>
                    )}
                  </div>
                </dialog>
              )}
            </li>
          );
        },
      )
    }
  </ul>
</Section>

<script>
  const openButtons = document.querySelectorAll<HTMLButtonElement>(".arch-cta");
  const closeButtons = document.querySelectorAll<HTMLButtonElement>(".close-modal");
  const modals = document.querySelectorAll<HTMLDialogElement>(".arch-modal");

  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const modalId = btn.getAttribute("data-modal");
      const modal = document.getElementById(modalId || "") as HTMLDialogElement | null;
      if (modal) {
        modal.showModal();
        document.body.style.overflow = "hidden";
      }
    });
  });

  const closeModal = (modal: HTMLDialogElement) => {
    modal.close();
    document.body.style.overflow = "";
  };

  closeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const modalId = btn.getAttribute("data-close");
      const modal = document.getElementById(modalId || "") as HTMLDialogElement | null;
      if (modal) closeModal(modal);
    });
  });

  modals.forEach((modal) => {
    modal.addEventListener("click", (e: MouseEvent) => {
      if (e.target === modal) closeModal(modal);
    });
  });

  // Carousel Navigation
  document.querySelectorAll<HTMLButtonElement>(".nav-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-carousel-target");
      const dir = btn.getAttribute("data-dir");
      const carousel = document.querySelector<HTMLElement>(
        `[data-carousel="${targetId}"]`,
      );
      if (!carousel) return;

      const slides = carousel.querySelectorAll<HTMLElement>(".carousel-slide");
      const scrollAmount = slides[0]?.clientWidth || 300;
      carousel.scrollBy({
        left: dir === "next" ? scrollAmount : -scrollAmount,
        behavior: "smooth",
      });
    });
  });

  // Dot Indicators via IntersectionObserver
  document.querySelectorAll<HTMLElement>(".carousel").forEach((carousel) => {
    const modalId = carousel.getAttribute("data-carousel");
    const dotsContainer = document.querySelector(`[data-dots="${modalId}"]`);
    if (!dotsContainer) return;
    const dots = dotsContainer.querySelectorAll(".dot");
    const slides = carousel.querySelectorAll(".carousel-slide");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = Array.from(slides).indexOf(entry.target as HTMLElement);
            dots.forEach((d, i) => d.classList.toggle("active", i === idx));
          }
        });
      },
      { root: carousel, threshold: 0.6 },
    );

    slides.forEach((slide) => observer.observe(slide));
  });
</script>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  .project-card {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    padding: var(--sp-6);
    height: 100%;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--border-default);
  }

  .project-header {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-2);
  }

  .title-row h3 {
    font-size: var(--fs-base);
    font-weight: 600;
    margin: 0;
  }

  .title-row h3 a {
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .title-row h3 a:hover {
    color: var(--accent-primary);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    font-weight: 500;
    white-space: nowrap;
    border: 1px solid var(--border-subtle);
    color: var(--text-tertiary);
    background: rgba(255, 255, 255, 0.03);
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-muted);
  }

  .status-active {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.2);
    background: rgba(56, 189, 248, 0.06);
  }

  .status-active .status-indicator {
    background-color: #38bdf8;
  }

  .description {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    margin-bottom: var(--sp-4);
  }

  .tech-tag {
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 2px 6px;
  }

  .card-actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: auto;
  }

  .actions-row {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    height: 34px;
    padding: 0 var(--sp-3);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    text-decoration: none;
    font-family: inherit;
    flex: 1;
  }

  .primary-cta {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .primary-cta:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--border-default);
  }

  .arch-cta {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .arch-cta:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-default);
    color: var(--text-primary);
  }

  .demo-creds-box {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    padding: var(--sp-1) var(--sp-2);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .demo-creds-box strong {
    color: var(--text-primary);
    font-family: monospace;
    font-size: 0.75rem;
  }

  /* Modal Styles */
  .arch-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    max-width: 980px;
    max-height: 85vh;
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    color: var(--text-primary);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85);
    margin: 0;
    overflow: hidden;
  }

  .arch-modal::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    display: flex;
    flex-direction: column;
    max-height: 85vh;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--sp-4) var(--sp-6);
    border-bottom: 1px solid var(--border-subtle);
    gap: var(--sp-3);
  }

  .modal-title-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .modal-title-row h3 {
    margin: 0;
    font-size: var(--fs-lg);
    font-weight: 600;
  }

  .close-modal {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: var(--sp-1);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast), background var(--duration-fast);
  }

  .close-modal:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .modal-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .modal-media {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--sp-6);
    border-right: 1px solid var(--border-subtle);
    background: var(--bg-base);
    overflow: hidden;
  }

  .carousel-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    width: 100%;
    align-items: center;
  }

  .carousel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: var(--sp-3);
    width: 100%;
    scrollbar-width: none;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .carousel-slide img {
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    object-fit: contain;
    max-height: 380px;
    width: 100%;
    background: #ffffff;
  }

  .carousel-slide figcaption {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: center;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .nav-btn {
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--border-default);
    transition: background var(--duration-fast);
  }

  .dot.active {
    background: var(--text-primary);
  }

  .modal-text {
    padding: var(--sp-6);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .modal-text h4 {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .architecture-paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .architecture-paragraphs p {
    font-size: var(--fs-xs);
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .architecture-paragraphs :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .modal-creds {
    padding: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-1);
  }

  .modal-footer {
    display: flex;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-6);
    border-top: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .modal-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    height: 36px;
    padding: 0 var(--sp-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .modal-link:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-default);
  }

  .primary-link {
    background: var(--text-primary);
    color: var(--bg-base);
    border-color: var(--text-primary);
  }

  .primary-link:hover {
    background: #ffffff;
    color: #000000;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .modal-body {
      grid-template-columns: 1fr;
    }

    .modal-media {
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      padding: var(--sp-4);
    }

    .carousel-slide img {
      max-height: 220px;
    }
  }

  @media print {
    .projects-grid {
      display: block !important;
    }

    .project-card {
      break-inside: avoid;
      margin-bottom: 1rem;
      border: 1px solid #e4e4e7 !important;
      background: transparent !important;
      padding: 0.75rem !important;
    }

    .tech-tag {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      color: #000 !important;
    }
  }
</style>
