---
import Section from "../Section.astro"
import Check from "@/icons/Check.astro"
import { work } from "@cv"

const { class: className } = Astro.props;
---

<Section title="Experiencia Laboral" class={`experience-section ${className || ''}`}>
  <ul class="jobs-list">
    {
      work.map(
        ({ name, startDate, endDate, position, summary, highlights, url }) => {
          const startYear = startDate ? new Date(startDate).getFullYear() : ""
          const endYear =
            endDate ? new Date(endDate).getFullYear() : "Actual"

          return (
            <li class="job-item">
              <article>
                <header class="job-header">
                  <div class="job-meta">
                    <h3>
                      {url ? (
                        <a href={url} title={`Ver ${name}`} target="_blank" rel="noopener noreferrer">
                          {name}
                        </a>
                      ) : (
                        <span>{name}</span>
                      )}
                    </h3>
                    <h4>{position}</h4>
                  </div>

                  <time datetime={startDate}>
                    {startYear} — {endYear}
                  </time>
                </header>

                <div class="job-body">
                  <p>{summary}</p>
                  {
                    highlights && highlights.length > 0 && (
                      <ul class="highlights">
                        {highlights.map((highlight) => (
                          <li>
                            <Check />
                            <span>{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    )
                  }
                </div>
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  .jobs-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .job-item article {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-3);
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .job-meta h3 {
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--text-primary);
  }

  .job-meta h3 a {
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .job-meta h3 a:hover {
    color: var(--accent-primary);
  }

  .job-meta h4 {
    color: var(--text-muted);
    font-weight: 400;
    font-size: var(--fs-sm);
  }

  time {
    color: var(--text-tertiary);
    font-size: var(--fs-xs);
    font-weight: 500;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .job-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-2);
    margin-top: var(--sp-1);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border-subtle);
  }

  .highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    line-height: 1.5;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .highlights li:hover {
    border-color: var(--border-default);
  }

  .highlights li :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .job-header {
      flex-direction: column;
      gap: var(--sp-1);
    }

    .highlights {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .highlights {
      border-top: 1px solid #e4e4e7 !important;
    }

    .highlights li {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      color: #000 !important;
    }

    .highlights li :global(svg) {
      color: #000 !important;
    }
  }
</style>
