---
import { basics } from "@cv"
import Section from "@/components/Section.astro"
import Phone from "@/icons/Phone.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import GitHub from "@/icons/GitHub.astro"
import Mail from "@/icons/Mail.astro"
import WorldMap from "@/icons/WorldMap.astro"

const { name, label, image, location, profiles, phone, email, summary } = basics
const { city, region } = location

const SOCIAL_ICONS: Record<string, (_props: Record<string, unknown>) => unknown> = {
  GitHub,
  LinkedIn,
  Phone,
  Mail
}

const safeProfiles = profiles || [];
const linkedInfo = safeProfiles.find(({ network }) => network === "LinkedIn")
const linkedUrl = linkedInfo?.url

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ")
const { class: className } = Astro.props;
---

<Section class={`hero-section ${className || ''}`}>
  <div class="container">
    <div class="info">
      <header class="hero-header">
        <h1>{name}</h1>
        <h2>{label}</h2>
      </header>

      <p class="summary">{summary}</p>

      <div class="location-badge">
        <WorldMap />
        <span>{city}, {region}</span>
      </div>

      <footer class="print">
        {printInfo}
      </footer>

      <footer class="no-print actions">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Enviar un correo a ${name} (${email})`}
              target="_blank"
              rel="noopener noreferrer"
              class="cta primary"
            >
              <Mail />
              <span>Contactar</span>
            </a>
          )
        }
        <div class="socials">
          {
            phone && (
              <a
                href={`tel:${phone}`}
                title={`Llamar a ${name} al ${phone}`}
                class="cta secondary"
                rel="noopener noreferrer"
                aria-label="Teléfono"
              >
                <Phone />
              </a>
            )
          }
          {
            safeProfiles.map(({ network, url }) => {
              const Icon = SOCIAL_ICONS[network]
              return (
                <a
                  href={url}
                  title={`Ver perfil de ${name} en ${network}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cta secondary"
                  aria-label={network}
                >
                  {Icon && <Icon />}
                </a>
              )
            })
          }
        </div>
      </footer>
    </div>

    <figure class="profile-figure">
      <img src={image} alt={name} width="128" height="128" />
    </figure>
  </div>
</Section>

<style>
  .hero-section {
    background: var(--bg-card);
  }

  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
  }

  .hero-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  h1 {
    font-size: var(--fs-3xl);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  h2 {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: var(--fs-base);
    line-height: 1.4;
  }

  .summary {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: 95%;
  }

  .location-badge {
    color: var(--text-tertiary);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .location-badge :global(svg) {
    color: var(--text-tertiary);
  }

  .profile-figure {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 120px;
    height: 120px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    background: var(--bg-elevated);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  img:hover {
    border-color: var(--border-hover);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-1);
    flex-wrap: wrap;
  }

  .socials {
    display: flex;
    gap: var(--sp-2);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    height: 36px;
    padding: 0 var(--sp-4);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 500;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    white-space: nowrap;
  }

  .cta.primary {
    background: var(--text-primary);
    color: var(--bg-base);
    border: 1px solid var(--text-primary);
  }

  .cta.primary:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
  }

  .cta.secondary {
    background: var(--bg-elevated);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: 0;
    width: 36px;
  }

  .cta.secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-default);
    color: var(--text-primary);
  }

  @media (max-width: 700px) {
    .container {
      flex-direction: column-reverse;
      text-align: left;
      align-items: flex-start;
      gap: var(--sp-4);
    }

    .info {
      align-items: flex-start;
      width: 100%;
    }

    h1 {
      font-size: var(--fs-2xl);
    }

    .profile-figure {
      align-self: flex-start;
    }

    img {
      width: 88px;
      height: 88px;
    }

    .actions {
      width: 100%;
    }
  }

  @media print {
    h1 {
      color: #000 !important;
    }
    h2 {
      color: #333 !important;
    }
    .profile-figure {
      border: none !important;
    }
    img {
      width: 90px !important;
      height: 90px !important;
      border: 1px solid #ccc !important;
    }
  }
</style>
