---
import Layout from "@/layouts/Layout.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import DownloadPDF from "@/components/DownloadPDF.astro";

import { basics, work, projects } from "@cv";
const { name, label, location } = basics;
---

<Layout title={`${name} · ${label} | ${location.city}, ${location.region}`}>
  <main>
    <Hero class="bento-hero" />
    {work && work.length > 0 && <Experience class="bento-experience" />}
    {projects && projects.length > 0 && <Projects class="bento-projects" />}
    <Skills class="bento-skills" />
    <Education class="bento-education" />
  </main>

  <DownloadPDF />
</Layout>

<style>
  main {
    padding: var(--sp-8) var(--sp-4);
    margin: 0 auto;
    width: 100%;
    max-width: 1000px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--sp-4);
  }

  @media (max-width: 900px) {
    main {
      grid-template-columns: 1fr;
      padding: var(--sp-6) var(--sp-4);
      gap: var(--sp-4);
    }
  }

  @media (max-width: 600px) {
    main {
      padding: var(--sp-4) var(--sp-3);
      gap: var(--sp-3);
    }
  }
</style>

<style is:global>
  .bento-hero { grid-column: span 6; }
  .bento-experience { grid-column: span 6; }
  .bento-projects { grid-column: span 6; }
  .bento-skills { grid-column: span 3; }
  .bento-education { grid-column: span 3; }

  @media (max-width: 900px) {
    .bento-hero,
    .bento-experience,
    .bento-projects,
    .bento-skills,
    .bento-education {
      grid-column: span 1;
    }
  }
</style>
